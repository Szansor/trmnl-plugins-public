{%- assign cfg = trmnl.plugin_settings.custom_fields_values -%}
{%- assign stop_label = cfg.stop_name | strip -%}
{%- if stop_label == blank -%}{%- assign stop_label = cfg.stop | split: "/" | last | split: "?" | first | split: "-" | first | upcase -%}{%- endif -%}
{%- assign show_wx = false -%}
{%- if weather and cfg.show_weather != "no" -%}{%- assign show_wx = true -%}{%- endif -%}
{%- capture bus_svg -%}<svg viewBox="0 0 64 64" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="18" width="5" height="11" rx="2" fill="currentColor"/><rect x="56" y="18" width="5" height="11" rx="2" fill="currentColor"/><rect x="14" y="50" width="9" height="9" rx="2" fill="currentColor"/><rect x="41" y="50" width="9" height="9" rx="2" fill="currentColor"/><path fill="currentColor" fill-rule="evenodd" d="M18 5h28a8 8 0 0 1 8 8v32a8 8 0 0 1-8 8H18a8 8 0 0 1-8-8V13a8 8 0 0 1 8-8zM19 10a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h26a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2zM18 20a3 3 0 0 0-3 3v11a3 3 0 0 0 3 3h28a3 3 0 0 0 3-3V23a3 3 0 0 0-3-3zM19 42a3 3 0 1 0 0 6 3 3 0 1 0 0-6zM45 42a3 3 0 1 0 0 6 3 3 0 1 0 0-6zM28 43a2 2 0 0 0 0 4h8a2 2 0 0 0 0-4z"/></svg>{%- endcapture -%}
{%- assign wx_icon_key = weather.icon -%}
{%- capture wx_svg -%}{% case wx_icon_key %}{% when 'sun' %}<svg viewBox="0 0 24 24" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="4.6" fill="currentColor"/><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" d="M12 1.6v2.6M12 19.8v2.6M1.6 12h2.6M19.8 12h2.6M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></svg>{% when 'moon' %}<svg viewBox="0 0 24 24" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.8 8.8 0 1 0 11.1 11.1z"/></svg>{% when 'partly' %}<svg viewBox="0 0 24 24" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><circle cx="8" cy="8" r="3.4" fill="currentColor"/><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M8 1.4v1.6M1.4 8h1.6M3.3 3.3l1.1 1.1M12.7 3.3l-1.1 1.1M3.3 12.7l1.1-1.1"/><path fill="currentColor" stroke="#fff" stroke-width="1.6" d="M9 21.5h9.5a4 4 0 0 0 .5-7.97A5.6 5.6 0 0 0 8.4 12.8a4.4 4.4 0 0 0 .6 8.7z"/></svg>{% when 'cloud' %}<svg viewBox="0 0 24 24" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M7 19.5h10.5a4.6 4.6 0 0 0 .6-9.16A6.2 6.2 0 0 0 6.4 9.2a5.2 5.2 0 0 0 .6 10.3z"/></svg>{% when 'fog' %}<svg viewBox="0 0 24 24" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" d="M3 6h18M6 10.5h12M3 15h18M7 19.5h10"/></svg>{% when 'rain' %}<svg viewBox="0 0 24 24" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M7 15h10.5a4.2 4.2 0 0 0 .5-8.37A5.8 5.8 0 0 0 6.6 5.4a4.8 4.8 0 0 0 .4 9.6z"/><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M8 18l-1.3 3.6M12.5 18l-1.3 3.6M17 18l-1.3 3.6"/></svg>{% when 'snow' %}<svg viewBox="0 0 24 24" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M7 15h10.5a4.2 4.2 0 0 0 .5-8.37A5.8 5.8 0 0 0 6.6 5.4a4.8 4.8 0 0 0 .4 9.6z"/><circle cx="7.5" cy="19" r="1.6" fill="currentColor"/><circle cx="12" cy="21.5" r="1.6" fill="currentColor"/><circle cx="16.5" cy="19" r="1.6" fill="currentColor"/></svg>{% when 'storm' %}<svg viewBox="0 0 24 24" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M7 15h10.5a4.2 4.2 0 0 0 .5-8.37A5.8 5.8 0 0 0 6.6 5.4a4.8 4.8 0 0 0 .4 9.6z"/><path fill="currentColor" stroke="#fff" stroke-width="1.4" stroke-linejoin="round" d="M13.6 9.5l-5.4 7.4h3.7l-2 6.3 7-8.7h-3.9l2.4-5z"/></svg>{% endcase %}{%- endcapture -%}
{%- capture title_icon -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture error_box -%}
<div class="flex flex--col flex--center-x flex--center-y gap--small text--center w--full h--full">
  <span class="w--16 h--16">{{ bus_svg }}</span>
  {%- if status == "no_data" -%}
  <span class="title">Nie znaleziono przystanku</span>
  <span class="description">Sprawdź link do przystanku w ustawieniach pluginu.</span>
  {%- else -%}
  <span class="title">Brak odjazdów</span>
  <span class="description">W najbliższym czasie nic nie odjeżdża z tego przystanku.</span>
  {%- endif -%}
</div>
{%- endcapture -%}
