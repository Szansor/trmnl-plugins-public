<div class="layout layout--row portrait:layout--col layout--stretch gap">
  {%- if ok -%}
  <div class="outline flex flex--row flex--center-x flex--center-y gap--medium px--3 w--[42cqw] portrait:w--full portrait:h--[48cqh] shrink-0">
    <div class="flex flex--col flex--center-x gap--small">
      <span class="w--10 h--10 lg:w--16 lg:h--16">{{ bus_svg }}</span>
      <span class="bg--black rounded--small px--2"><span class="value value--small lg:value--large value--tnums text--white">{{ first.line }}</span></span>
    </div>
    <div class="flex flex--col flex--center-x gap--xsmall">
      {%- if first.cancelled -%}
      <span class="value value--large lg:value--xlarge">{{ t_cancelled }}</span>
      {%- else -%}
      <span class="value value--xlarge lg:value--xxlarge value--tnums">{{ first.real }}</span>
      {%- endif -%}
      {%- if first.delay_txt != blank -%}<span class="label label--small lg:label--base {% if first.late %}label--filled{% else %}label--outline{% endif %}">{{ first.delay_txt }}</span>{%- endif -%}
      <span class="label label--small lg:label--base" data-clamp="1" data-clamp-lg="1">→ {{ first.headsign }}</span>
    </div>
  </div>
  <div class="flex flex--col flex--stretch-x gap--xsmall grow">
    <div class="flex flex--row flex--between flex--center-y px--1">
      <span class="label label--small lg:label--base">{{ t_next }} · {{ stop_label }}</span>
      {%- if show_wx -%}
      <div class="flex flex--row flex--center-y gap--xsmall">
        <span class="w--5 h--5 lg:w--7 lg:h--7">{{ wx_svg }}</span>
        <span class="label lg:label--large">{{ weather.temp }}°</span>
      </div>
      {%- endif -%}
    </div>
    {%- for d in rest limit: 3 -%}
    <div class="outline flex flex--row flex--center-y gap--small px--2 grow{% if forloop.index == 3 %} hidden lg:flex{% endif %}">
      <span class="bg--black rounded--small text--center px--1 w--min-14 lg:w--min-20 shrink-0"><span class="value value--small lg:value--base value--tnums text--white">{{ d.line }}</span></span>
      <div class="flex flex--row flex--left grow"><span class="label label--small lg:label--base" data-clamp="1" data-clamp-lg="1">→ {{ d.headsign }}</span></div>
      <span class="value value--small lg:value--base value--tnums shrink-0">{% if d.cancelled %}{{ t_cancelled }}{% else %}{{ d.real }}{% endif %}</span>
      <span class="label label--small lg:label--base shrink-0">{{ d.delay_txt }}</span>
    </div>
    {%- endfor -%}
    {%- if rest.size == 0 -%}
    <div class="outline flex flex--center-x flex--center-y grow"><span class="label label--small">{{ t_none_more }}</span></div>
    {%- endif -%}
  </div>
  {%- else -%}
  {{ error_box }}
  {%- endif -%}
</div>
<div class="title_bar">
  <img class="image image--adaptive" src="{{ title_icon }}">
  <span class="title">{{ t_title }} · {{ stop_label }}</span>
  <span class="instance">{{ t_live }} {{ fetched }}</span>
</div>
