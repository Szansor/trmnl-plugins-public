<div class="layout layout--col layout--stretch-x gap--small">
  {%- if ok -%}
  <div class="flex flex--row portrait:flex--col flex--center-y flex--around gap--small grow">
    <div class="flex flex--col portrait:flex--row flex--center-x flex--center-y gap--small">
      <span class="w--10 h--10 lg:w--16 lg:h--16 portrait:w--8 portrait:h--8">{{ bus_svg }}</span>
      <span class="bg--black rounded--small px--2"><span class="value value--small lg:value--large value--tnums text--white">{{ first.line }}</span></span>
    </div>
    <div class="flex flex--col flex--center-x gap--xsmall">
      {%- if first.cancelled -%}
      <span class="value value--large">{{ t_cancelled }}</span>
      {%- else -%}
      <span class="value value--xlarge lg:value--xxlarge portrait:value--xlarge lg:portrait:value--xxlarge value--tnums">{{ first.real }}</span>
      {%- endif -%}
      {%- if first.delay_txt != blank -%}<span class="label label--small lg:label--base {% if first.late %}label--filled{% else %}label--outline{% endif %}">{{ first.delay_txt }}</span>{%- endif -%}
    </div>
  </div>
  {%- for d in rest limit: 3 -%}
  <div class="hidden lg:portrait:flex outline flex--row flex--center-y gap--small px--2 py--1 shrink-0">
    <span class="bg--black rounded--small text--center px--1 w--min-20 shrink-0"><span class="value value--base value--tnums text--white">{{ d.line }}</span></span>
    <div class="flex flex--row flex--left grow"><span class="label label--base" data-clamp="1" data-clamp-lg="1">→ {{ d.headsign }}</span></div>
    <span class="value value--base value--tnums shrink-0">{% if d.cancelled %}{{ t_cancelled }}{% else %}{{ d.real }}{% endif %}</span>
  </div>
  {%- endfor -%}
  <div class="outline flex flex--row flex--between lg:portrait:flex--right flex--center-y gap--small px--2 py--1 shrink-0">
    <span class="label label--small lg:label--base lg:portrait:hidden" data-clamp="1" data-clamp-lg="1">{{ t_then }}{% for d in rest limit: 2 %} · {{ d.line }} {% if d.cancelled %}{{ t_cancelled }}{% else %}{{ d.real }}{% endif %}{% endfor %}</span>
    {%- if show_wx -%}
    <div class="flex flex--row flex--center-y gap--xsmall shrink-0">
      <span class="w--5 h--5 lg:w--7 lg:h--7">{{ wx_svg }}</span>
      <span class="label label--small lg:label--base">{{ weather.temp }}°</span>
    </div>
    {%- endif -%}
  </div>
  {%- else -%}
  {{ error_box }}
  {%- endif -%}
</div>
<div class="title_bar">
  <img class="image image--adaptive" src="{{ title_icon }}">
  <span class="title">{{ t_title }}</span>
  <span class="instance">{{ stop_label }} · {{ fetched }}</span>
</div>
