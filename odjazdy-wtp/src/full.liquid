<div class="layout layout--row portrait:layout--col layout--stretch gap--medium">
  {%- if ok -%}
  <div class="outline flex flex--col flex--center-x flex--center-y gap--small p--3 text--center w--[37cqw] portrait:w--full portrait:h--[40cqh] shrink-0">
    <div class="flex flex--row flex--center-y gap">
      <span class="w--14 h--14 lg:w--24 lg:h--24">{{ bus_svg }}</span>
      <span class="bg--black rounded--small px--3 lg:px--4"><span class="value value--large lg:value--xxlarge value--tnums text--white">{{ first.line }}</span></span>
    </div>
    <span class="label lg:label--large" data-clamp="1">→ {{ first.headsign | truncate: 30 }}</span>
    {%- if first.cancelled -%}
    <span class="value value--xlarge lg:value--xxlarge">odwołany</span>
    {%- else -%}
    <span class="value value--xxlarge lg:value--mega lg:portrait:value--xxxlarge value--tnums">{{ first.real }}</span>
    {%- endif -%}
    <span class="label {% if first.late %}label--filled{% else %}label--outline{% endif %} lg:label--large">{{ first.delay_txt }}</span>
    <span class="label label--small lg:label--base">rozkład {{ first.sched }}</span>
  </div>
  <div class="flex flex--col flex--stretch-x gap--small grow">
    <div class="flex flex--row flex--between flex--center-y px--1">
      <span class="label lg:label--large">NASTĘPNE · {{ stop_label }}</span>
      {%- if show_wx -%}
      <div class="flex flex--row flex--center-y gap--small">
        <span class="w--7 h--7 lg:w--9 lg:h--9">{{ wx_svg }}</span>
        <span class="value value--small lg:value--base value--tnums">{{ weather.temp }}°</span>
      </div>
      {%- endif -%}
    </div>
    {%- for d in rest limit: 6 -%}
    <div class="outline flex flex--row flex--center-y gap px--3 grow{% if forloop.index == 5 %} hidden lg:flex{% elsif forloop.index == 6 %} hidden lg:flex lg:portrait:hidden{% endif %}">
      <span class="bg--black rounded--small text--center px--2 w--min-20 lg:w--min-28 shrink-0"><span class="value value--tnums text--white lg:value--large">{{ d.line }}</span></span>
      <div class="flex flex--row flex--left grow"><span class="label lg:label--large" data-clamp="1">→ {{ d.headsign | truncate: 30 }}</span></div>
      <div class="flex flex--col flex--end shrink-0">
        <span class="value value--tnums lg:value--large">{% if d.cancelled %}odwołany{% else %}{{ d.real }}{% endif %}</span>
        <span class="label label--small lg:label--base">{{ d.delay_txt }}</span>
      </div>
    </div>
    {%- endfor -%}
    {%- if rest.size == 0 -%}
    <div class="outline flex flex--center-x flex--center-y grow"><span class="label">Brak kolejnych odjazdów</span></div>
    {%- endif -%}
  </div>
  {%- else -%}
  {{ error_box }}
  {%- endif -%}
</div>
<div class="title_bar">
  <img class="image image--adaptive" src="{{ title_icon }}">
  <span class="title">Odjazdy · {{ stop_label }}</span>
  <span class="instance">na żywo z {{ fetched }}</span>
</div>
